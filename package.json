{
  "name": "marked-gfm-heading-id",
  "version": "4.1.4",
  "description": "marked GFM heading ids",
  "main": "./lib/index.cjs",
  "module": "./src/index.js",
  "browser": "./lib/index.umd.js",
  "type": "module",
  "types": "./lib/index.d.cts",
  "files": [
    "lib/",
    "src/"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "keywords": [
    "marked",
    "extension"
  ],
  "scripts": {
    "test": "jest --verbose",
    "test:cover": "jest --coverage",
    "test:types": "npm run build && tsd -t src/index.d.ts -f spec/index.test-d.ts && attw -P",
    "lint": "eslint",
    "build": "rollup -c rollup.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markedjs/marked-gfm-heading-id.git"
  },
  "author": "Tony Brix <Tony@Brix.ninja> (https://Tony.Brix.ninja)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/markedjs/marked-gfm-heading-id/issues"
  },
  "homepage": "https://github.com/markedjs/marked-gfm-heading-id#readme",
  "peerDependencies": {
    "marked": ">=13 <19"
  },
  "dependencies": {
    "github-slugger": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@markedjs/eslint-config": "^1.0.14",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest-cli": "^30.5.2",
    "marked": "^18.2.1",
    "rollup": "^4.68.7",
    "rollup-plugin-copy": "^3.5.0",
    "semantic-release": "^26.0.1",
    "tsd": "^0.33.0"
  }
}
